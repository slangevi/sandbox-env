    if [ "$(docker container inspect --format '{{.State.Running}}' "sandbox-${name}" 2>/dev/null)" != "true" ]; then
        error "No running sandbox found. Run 'sandbox run' first."
        exit 1
    fi

    shift # remove 'exec' from args
    if [ $# -eq 0 ]; then
        error "Usage: sandbox exec <command> [args...]"
        exit 1
    fi

    local tty_flag=""
    if [ -t 0 ] && [ -t 1 ]; then
        tty_flag="-it"
    fi
    docker exec $tty_flag "sandbox-${name}" "$@"
