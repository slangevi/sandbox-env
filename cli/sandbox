cmd_llm() {
    find_config
    local name
    name=$(project_name)
    if [ -z "$name" ]; then
        error "sandbox.yaml must have a 'name' field."
        exit 1
    fi

    local spark=false
    if [ "${1:-}" = "--spark" ]; then
        spark=true
        shift
        _load_spark_env
        _spark_guard_firewall
    fi

    # If container is running, exec into it
    if [ "$(docker container inspect --format '{{.State.Running}}' "sandbox-${name}" 2>/dev/null)" = "true" ]; then
        if $spark; then
            # Can't be made to work: the gateway's model registry has to be
            # mounted as a directory at container start (see below), and
            # `docker exec` cannot add a new mount to an already-running
            # container. Refuse cleanly instead of shipping a silently
            # broken path that only sets inert OPENAI_* env vars.
            error "llm --spark cannot attach to an already-running sandbox."
            error "The gateway model registry must be mounted at container start."
            error "Run 'sandbox stop' first, then retry."
            exit 1
        else
            docker exec -it "sandbox-${name}" bash -lc 'llm "$@"' _ "$@"
        fi
        return
    fi

    # Otherwise start a new container and run llm
    if [ -z "$(docker image ls -q "sandbox-${name}:latest" 2>/dev/null)" ]; then
        error "Project image not found. Run 'sandbox build' first."
        exit 1
    fi

    _build_docker_args "$name"
    if $spark; then
        # llm 0.24 has no OpenAI-compatible passthrough: it never reads
        # OPENAI_BASE_URL, and get_model() resolves `-m NAME` against
        # registered model ids/aliases ONLY — never against model_name
        # (llm/__init__.py get_model_aliases()). So a single placeholder
        # entry (e.g. model_id: sparkyard) would only ever answer to
        # `-m sparkyard`, never to the real sparkyard model names people
        # actually type (`-m qwen3-coder-next`, etc). Register one
        # extra-openai-models.yaml entry per model the gateway currently
        # serves, with model_id set to the gateway's own model id, so
        # `-m <model>` resolves directly. (Confirmed against the 0.24
        # source; also confirmed empirically that dropping api_key_name
        # here makes llm send a hardcoded "DUMMY_KEY" instead of falling
        # back to $OPENAI_API_KEY — openai_models.py sets needs_key=None
        # whenever api_base is set, UNLESS api_key_name overrides it, so
        # api_key_name must stay.)
        #
        # Mounted under /home/node/.sparkyard-llm (NOT llm's default
        # ~/.config/io.datasette.llm): entrypoint.sh symlinks
        # /home/node/.config into the persistent volume via `rm -rf
        # /home/node/.config && ln -sfn ...`, and rm fails ("Device or
        # resource busy") on a directory containing a bind-mounted file,
        # aborting the entrypoint under set -e. LLM_USER_PATH redirects
        # llm's own config lookup there instead.
        #
        # The registry is generated on the HOST, so it can't be trusted to
        # be readable by the container's node user on every host: host uid
        # varies (CI runs as uid 1001; multi-user Linux and macOS commonly
        # differ from the image's uid 1000 too), and mktemp -d's ownership
        # just passes that host uid straight through. So instead of gating
        # on a specific host uid, ownership is made a non-issue: the
        # registry is bind-mounted READ-ONLY at a neutral path
        # (/tmp/sparkyard-llm) that any container user can read regardless
        # of host uid, then copied at container start into a directory the
        # container itself creates and owns (~/.sparkyard-llm) — which
        # `llm` can write logs.db into.
        #
        # Trade-off: LLM_USER_PATH relocates llm's ENTIRE user directory
        # (keys, aliases, templates, and the `llm logs` history db) to
        # this temp dir, which is deleted when the command exits. None of
        # that persists between --spark invocations.
        warn "llm --spark: history, keys, and templates are not persisted between runs."

        local host_url models_list
        host_url=$(_spark_host_url)
        models_list=$(_spark_list_models)
        if [ -z "$models_list" ]; then
            error "Could not list models from ${host_url}/v1/models"
            error "Is the sparkyard stack up? Try: sparkyard start"
            exit 1
        fi

        # spark_tmp is intentionally NOT `local`: the EXIT trap below fires
        # after this function has already returned (control is back in the
        # top-level case statement), by which point a `local` would be out
        # of scope and `set -u` would abort the trap itself with "unbound
        # variable" — reproduced with the previous `local spark_tmp` +
        # double-quoted-trap combination. Making it a script-global lets the
        # trap body stay single-quoted (deferred expansion) and still find
        # the right value at trap-fire time.
        local llm_cfg
        spark_tmp=$(mktemp -d)
        trap 'rm -rf "$spark_tmp"' EXIT INT TERM
        llm_cfg="$spark_tmp/extra-openai-models.yaml"
        : > "$llm_cfg"
        while IFS= read -r m; do
            [ -z "$m" ] && continue
            {
                echo "- model_id: \"$m\""
                echo "  model_name: \"$m\""
                echo "  api_base: \"${SPARK_URL}/v1\""
                echo "  api_key_name: sparkyard"
            } >> "$llm_cfg"
        done <<< "$models_list"

        # Only now does the registry actually exist — log success after
        # generating it, not before (previously this fired even before the
        # uid gate that could abort the command entirely).
        log "sparkyard models registered. The first call after a model swap can take several minutes while it loads."

        chmod 0755 "$spark_tmp"
        chmod 0644 "$llm_cfg"
        DOCKER_ARGS+=("--add-host" "host.docker.internal:host-gateway")
        DOCKER_ARGS+=("-v" "$spark_tmp:/tmp/sparkyard-llm:ro")
        DOCKER_ARGS+=("-e" "LLM_USER_PATH=/home/node/.sparkyard-llm")
        DOCKER_ARGS+=("-e" "OPENAI_API_KEY=${SPARK_KEY}")
        _spark_run run "${DOCKER_ARGS[@]}" \
            "sandbox-${name}:latest" \
            bash -lc 'mkdir -p ~/.sparkyard-llm && cp /tmp/sparkyard-llm/extra-openai-models.yaml ~/.sparkyard-llm/ && llm "$@"' _ "$@"
        return
    fi

    docker run "${DOCKER_ARGS[@]}" \
        "sandbox-${name}:latest" \
        bash -lc 'llm "$@"' _ "$@"
}

cmd_start() {
    find_config
    local name
    name=$(project_name)
    if [ -z "$name" ]; then
        error "sandbox.yaml must have a 'name' field."
        exit 1
    fi

    if [ -z "$(docker image ls -q "sandbox-${name}:latest" 2>/dev/null)" ]; then
        error "Project image not found. Run 'sandbox build' first."
        exit 1
    fi

    # Check if already running
    if [ "$(docker container inspect --format '{{.State.Running}}' "sandbox-${name}" 2>/dev/null)" = "true" ]; then
        log "sandbox-${name} is already running."
        return 0
    fi

    # Clean up any stopped container with the same name
    docker rm "sandbox-${name}" 2>/dev/null || true

    log "Starting sandbox-${name} in background..."
    _build_docker_args "$name"

    # Remove --rm so container persists, run detached with sleep infinity
    local start_args=()
    for arg in "${DOCKER_ARGS[@]}"; do
        [ "$arg" = "--rm" ] && continue
        start_args+=("$arg")
    done

    docker run -d "${start_args[@]}" \
        "sandbox-${name}:latest" \
        sleep infinity >/dev/null

    # Wait for container to be ready
    for i in $(seq 1 10); do
        if [ "$(docker container inspect --format '{{.State.Running}}' "sandbox-${name}" 2>/dev/null)" = "true" ]; then
            log "sandbox-${name} is running. Use 'sandbox claude', 'sandbox llm', 'sandbox shell', etc."
            log "Stop with: sandbox stop"
            return 0
        fi
        sleep 1
    done

    error "Container failed to start. Check: docker logs sandbox-${name}"
    exit 1
}

