cmd_claude_spark() {
    find_config
    local name
    name=$(project_name)
    if [ -z "$name" ]; then
        error "sandbox.yaml must have a 'name' field."
        exit 1
    fi

    _load_spark_env
    # Called once, before the attach-vs-fresh branch below, so it guards both:
    # the attach (docker exec) branch used to skip this entirely.
    _spark_guard_firewall

    # Validate arguments BEFORE the image guard: cheap checks first, and a bad
    # model name should say so rather than blaming a missing image.
    #
    # $1 must NOT be consumed as the model name when it looks like a flag
    # (e.g. --continue, --resume) — otherwise a configured SPARKYARD_MODEL
    # default and flag pass-through are mutually exclusive. Same guard as
    # `run --spark` (commit 1dc4f15).
    local model="$SPARK_DEFAULT_MODEL"
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
        model="$1"
        shift
    fi
    if [ -z "$model" ]; then
        error "Usage: sandbox claude-spark <model> [claude-args...]"
        error "Example: sandbox claude-spark qwen3-coder-next"
        error "Or set SPARKYARD_MODEL in $(spark_config_path)"
        exit 1
    fi
    validate_model "$model"

    if [ -z "$(docker image ls -q "sandbox-${name}:latest" 2>/dev/null)" ]; then
        error "Project image not found. Run 'sandbox build' first."
        exit 1
    fi

    _spark_preflight "$model"

    # Already running: exec in. The running container may lack the
    # host.docker.internal alias, so resolve the gateway IP from the host.
    if [ "$(docker container inspect --format '{{.State.Running}}' "sandbox-${name}" 2>/dev/null)" = "true" ]; then
        local exec_url="$SPARK_URL" gw
        if [[ "$exec_url" == *host.docker.internal* ]]; then
            # A trailing separator after each gateway lets awk disambiguate a
            # multi-network container instead of concatenating them with no
            # boundary (which `head -n1` alone can't parse back apart).
            gw=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.Gateway}} {{end}}' "sandbox-${name}" 2>/dev/null | awk '{print $1; exit}')
            if [ -n "$gw" ]; then
                exec_url="${exec_url//host.docker.internal/$gw}"
            else
                warn "Could not resolve the container's gateway; host.docker.internal may not resolve inside it."
            fi
        fi
        log "Attaching to Claude Code (sparkyard: $model) in sandbox-${name}..."
        _spark_run exec -it \
            -e "ANTHROPIC_BASE_URL=$exec_url" \
            -e "ANTHROPIC_AUTH_TOKEN=$SPARK_KEY" \
            -e "ANTHROPIC_API_KEY=" \
            "sandbox-${name}" claude --model "$model" "$@"
        return
    fi

    log "Starting Claude Code with sparkyard model: $model"
    _build_docker_args "$name"
    _read_claude_config
    _apply_spark_backend
    DOCKER_ARGS+=("-e" "ANTHROPIC_API_KEY=")

    _spark_run run -it "${DOCKER_ARGS[@]}" \
        "sandbox-${name}:latest" \
        claude --model "$model" $SKIP_PERMISSIONS_FLAG ${CLAUDE_EXTRA_ARGS[@]+"${CLAUDE_EXTRA_ARGS[@]}"} "$@"
}

